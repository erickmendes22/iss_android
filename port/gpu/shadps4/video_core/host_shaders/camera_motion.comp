// tlg: camera motion vectors from depth and the current/previous camera (the scene
// constants, see docs/upscaler.md; layout still to be recalibrated for God of War III). DEBUG_OVERLAY blends them as colors into the frame.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex; // D32, depth 0..1 (D3D projection)
#ifdef DEBUG_OVERLAY
layout(binding = 1, rgba8) uniform image2D color_img;
layout(binding = 2, std430) readonly buffer PrevFrame { uint prev_frame[]; };
layout(binding = 3, std430) writeonly buffer NextFrame { uint next_frame[]; };
#else
layout(binding = 1, rg16f) uniform writeonly image2D motion_img; // pixels, previous - current
// Object motion from the G-buffer: rg pixels, b = valid, a = written depth.
layout(binding = 2) uniform texture2D object_tex;
#endif

layout(push_constant) uniform Constants {
    vec4 reproject[3]; // previous view * inverse current view, rows (3x4)
    vec4 proj;         // current: x scale, y scale, z scale, z offset
    vec4 prev_proj;    // previous: x scale, y scale, z scale, z offset
    vec2 size;         // pixels
    vec2 jitter;       // current viewport shift in render pixels (x right, y down)
    vec2 previous_jitter;
    uint mode;         // motion: 1 = original camera + object, 2 = objects only
                       //         3 = ISS native camera + object, 4 = ISS camera only
                       //         debug: 0 motion, 1 raw
                       // depth, 2 view z / 50, 3 reprojected previous frame, 4 |difference|
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    const float depth = texelFetch(depth_tex, pixel, 0).r;
#ifndef DEBUG_OVERLAY
    // ISS Android experimental mode: per-pixel vertex motion is available, but the
    // Bloodborne 864-byte global camera structure has not been found in this game.
    // Do not reconstruct any world position or project with an invalid camera.
    // Uncovered/occluded pixels get zero motion instead of NaNs or invented camera motion.
    // ISS camera mode: the verified game 4x4 matrices were multiplied on the
    // host as previous_composite * inverse(current_composite), ROW-MAJOR.
    // They map CURRENT NDC clip coordinates into PREVIOUS clip coordinates.
    // The fourth row occupies the old 'proj' push-constant slot. Never use
    // Bloodborne's affine/3000-far-plane assumptions for this mode.
    if (mode == 3u || mode == 4u) {
        const vec2 uv = (vec2(pixel) + 0.5) / size;
        // Viewport jitter is applied by the Vulkan rasterizer, separately
        // from the native game's projection matrix. Remove that offset from
        // the clip reconstruction, just as the original camera shader does.
        const vec2 scene_uv = uv - jitter / size;
        const vec4 current_clip = vec4(scene_uv.x * 2.0 - 1.0,
                                       1.0 - scene_uv.y * 2.0, depth, 1.0);
        const vec4 previous_clip = vec4(
            dot(reproject[0], current_clip),
            dot(reproject[1], current_clip),
            dot(reproject[2], current_clip),
            dot(proj, current_clip));
        vec2 result = vec2(0.0);
        if (!any(isnan(previous_clip)) && !any(isinf(previous_clip)) &&
            abs(previous_clip.w) > 1.0e-5) {
            const vec2 prev_ndc = previous_clip.xy / previous_clip.w;
            const vec2 prev_uv = vec2(prev_ndc.x * 0.5 + 0.5,
                                      0.5 - prev_ndc.y * 0.5);
            // The native matrices contain inFAMOUS' own quarter-pixel
            // projection jitter in addition to the Android viewport jitter.
            // previous_jitter is the guest projection jitter delta (pixels)
            // for mode 3/4. FSR motion vectors must not contain that delta.
            const vec2 camera_motion =
                (prev_uv - scene_uv) * size - previous_jitter;
            if (!any(isnan(camera_motion)) && !any(isinf(camera_motion)) &&
                all(lessThan(abs(camera_motion), size * 0.5))) {
                result = camera_motion;
            }
        }
        // Per-object vectors take priority only at the exact scene depth;
        // all uncovered pixels receive native camera reprojected motion.
        if (mode == 3u) {
            const vec4 object_motion = texelFetch(object_tex, pixel, 0);
            // ISS uses reversed-Z: near ~= 1, far ~= 0. Old (1-depth) gave
            // distant geometry a tolerance close to 0.01, accepting unrelated
            // object motion at a different depth and smearing FSR history.
            // Compare relative to actual reversed depth, like the non-ISS
            // camera path does for its forward-Z convention.
            const float threshold = max(2e-7, depth * 0.01);
            if (object_motion.b > 0.99 &&
                abs(object_motion.a - depth) < threshold &&
                !any(isnan(object_motion.rg)) &&
                !any(isinf(object_motion.rg))) {
                result = object_motion.rg;
            }
        }
        imageStore(motion_img, pixel, vec4(result, 0.0, 0.0));
        return;
    }
    if (mode == 2u) {
        const vec4 object_motion = texelFetch(object_tex, pixel, 0);
        // Reversed-Z is shared by object-only fallback and native-camera
        // motion. A stale foreground vector must not win over camera motion.
        const float depth_threshold = max(2e-7, depth * 0.01);
        vec2 result = vec2(0.0);
        if (object_motion.b > 0.99 &&
            abs(object_motion.a - depth) < depth_threshold &&
            !any(isnan(object_motion.rg)) && !any(isinf(object_motion.rg))) {
            result = object_motion.rg;
        }
        imageStore(motion_img, pixel, vec4(result, 0.0, 0.0));
        return;
    }
#endif
    const vec2 uv = (vec2(pixel) + 0.5) / size;
    // Depth was rasterised through a shifted viewport. Reconstruct its unjittered
    // position, and keep jitter out of FSR's motion vectors (as for the object vectors).
    const vec2 scene_uv = uv - jitter / size;
    const vec2 ndc = vec2(scene_uv.x * 2.0 - 1.0, 1.0 - scene_uv.y * 2.0);

    // Clip z = zs * z + zo, w = z; depth = zs + zo / z (zo < 0, depth < zs in front).
    const bool sky = depth >= 1.0;
    const float denom = min(depth - proj.z, -1e-8);
    const float z = sky ? 1.0 : proj.w / denom;
    // Clear depth is an infinite direction: rotate it with the camera, without translation.
    // A threshold below 1 incorrectly classified distant geometry as motionless sky.
    const vec4 view = vec4(ndc.x * z / proj.x, ndc.y * z / proj.y, z, sky ? 0.0 : 1.0);
    const vec3 prev_view =
        vec3(dot(reproject[0], view), dot(reproject[1], view), dot(reproject[2], view));
    const vec2 prev_ndc =
        vec2(prev_view.x * prev_proj.x, prev_view.y * prev_proj.y) / max(prev_view.z, 1e-4);
    const vec2 prev_uv = vec2(prev_ndc.x * 0.5 + 0.5, 0.5 - prev_ndc.y * 0.5);
    const vec2 motion = (prev_uv - scene_uv) * size;

#ifdef DEBUG_OVERLAY
    const vec4 current = imageLoad(color_img, pixel);
    next_frame[pixel.y * int(size.x) + pixel.x] = packUnorm4x8(current);
    if (mode == 3 || mode == 4) {
        const ivec2 prev_pixel = ivec2(floor(uv * size + motion + previous_jitter - jitter));
        vec4 prev = vec4(0.0, 0.0, 0.0, 1.0);
        if (all(greaterThanEqual(prev_pixel, ivec2(0))) && all(lessThan(prev_pixel, ivec2(size)))) {
            prev = unpackUnorm4x8(prev_frame[prev_pixel.y * int(size.x) + prev_pixel.x]);
        }
        const vec3 out_color = mode == 3 ? prev.rgb : abs(prev.rgb - current.rgb) * 4.0;
        imageStore(color_img, pixel, vec4(out_color, current.a));
        return;
    }
    if (mode == 1) {
        // Raw depth visualization
        imageStore(color_img, pixel, vec4(fract(depth * 4.0), depth, depth < 0.0 ? 1.0 : 0.0, 1.0));
        return;
    } else if (mode == 2) {
        // View-space depth visualization (z / 50)
        const float v = z / 50.0;
        imageStore(color_img, pixel, vec4(fract(v * 4.0), v, v < 0.0 ? 1.0 : 0.0, 1.0));
        return;
    }
    // Mode 0: motion vectors blended with current frame
    // Red/green: horizontal/vertical motion (grey = none), 64 pixels to full scale.
    // Sky = dark blue, motion magnitude shown by color deviation from grey
    const vec3 mv_color = sky ? vec3(0.0, 0.0, 0.3) : vec3(0.5) + vec3(motion / 128.0, 0.0);
    imageStore(color_img, pixel, vec4(mix(current.rgb, mv_color, 0.75), current.a));
#else
    vec2 result = motion;
    if (mode == 1) {
        const vec4 object_motion = texelFetch(object_tex, pixel, 0);
        // A later ordinary draw may have covered this pixel without touching the motion
        // target. Its final depth then differs from the depth stored with the vector.
        // Both depths are full precision. Do not accept an old foreground vector merely
        // because perspective depth compresses distant surfaces into a small interval.
        float depth_threshold = max(2e-7, (proj.z - depth) * 0.01);
        if (object_motion.b > 0.99 && abs(object_motion.a - depth) < depth_threshold &&
            !any(isnan(object_motion.rg)) &&
            !any(isinf(object_motion.rg))) {
            result = object_motion.rg;
        }
    }
    imageStore(motion_img, pixel, vec4(result, 0.0, 0.0));
#endif
}
