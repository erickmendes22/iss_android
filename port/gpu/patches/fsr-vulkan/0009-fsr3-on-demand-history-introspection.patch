 typedef struct FfxVkPortableFrameGenerationContext FfxVkPortableFrameGenerationContext;
 
 /* SDK-reported memory owned by the FSR effect. Application-provided color,
  * depth, motion, and output images are deliberately excluded. */
+/* Read-only, on-demand introspection of the pinned FSR3 context. The caller
+ * must restore each returned layout after a diagnostic copy. Never cache the
+ * handles across dispatches or call while another thread records this context. */
+typedef struct FfxVkPortableUpscaleDebugImage {
+    VkImage image;
+    VkFormat format;
+    VkImageLayout layout;
+    uint32_t width, height;
+} FfxVkPortableUpscaleDebugImage;
+typedef struct FfxVkPortableUpscaleDebugInfo {
+    uint32_t structSize, validImages;
+    float frameIndex, jitterPhaseCount;
+    float jitter[2], previousJitter[2], motionVectorScale[2];
+    float preExposure, deltaPreExposure;
+    /* previous color, current color before RCAS, accumulation, reactive masks */
+    FfxVkPortableUpscaleDebugImage images[4];
+} FfxVkPortableUpscaleDebugInfo;
+FfxVkPortableResult ffxVkPortableUpscaleContextGetDebugInfo(
+    FfxVkPortableUpscaleContext* context, FfxVkPortableUpscaleDebugInfo* info);
+
+
 typedef struct FfxVkPortableMemoryUsage {
     uint32_t structSize;
     uint64_t totalUsageInBytes;
