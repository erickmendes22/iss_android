     case FFX_SURFACE_FORMAT_R32_FLOAT:
         return VK_FORMAT_R32_SFLOAT;
     case FFX_SURFACE_FORMAT_R16G16_FLOAT:
@@ -560,6 +565,48 @@
         return fromFfxResult(result);
     usage->totalUsageInBytes = ffxUsage.totalUsageInBytes;
