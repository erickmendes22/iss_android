+}
+
+extern "C" FfxVkPortableResult ffxVkPortableUpscaleContextGetDebugInfo(
+    FfxVkPortableUpscaleContext* context, FfxVkPortableUpscaleDebugInfo* info)
+{
+    if (!context || !info) return FFX_VK_PORTABLE_ERROR_INVALID_POINTER;
+    if (info->structSize < sizeof(*info)) return FFX_VK_PORTABLE_ERROR_INVALID_STRUCT_SIZE;
+    if (context->magic != kContextMagic || !context->ffxContextCreated ||
+        !context->sharedResourcesInitialized) return FFX_VK_PORTABLE_ERROR_INVALID_ARGUMENT;
+    std::lock_guard<std::mutex> lock(context->mutex);
+    auto* state = reinterpret_cast<FfxFsr3UpscalerContext_Private*>(&context->ffxContext);
+    FfxVkPortableUpscaleDebugInfo result{};
+    result.structSize = sizeof(result);
+    result.frameIndex = state->constants.frameIndex;
+    result.jitterPhaseCount = state->constants.jitterPhaseCount;
+    result.preExposure = state->preExposure;
+    result.deltaPreExposure = state->constants.deltaPreExposure;
+    for (unsigned i=0; i<2; ++i) {
+        result.jitter[i] = state->constants.jitterOffset[i];
+        result.previousJitter[i] = state->constants.previousFrameJitterOffset[i];
+        result.motionVectorScale[i] = state->constants.motionVectorScale[i];
+    }
+    const FfxResourceInternal resources[] = {
+        state->srvResources[FFX_FSR3UPSCALER_RESOURCE_IDENTIFIER_INTERNAL_UPSCALED_COLOR],
+        state->uavResources[FFX_FSR3UPSCALER_RESOURCE_IDENTIFIER_INTERNAL_UPSCALED_COLOR],
+        state->uavResources[FFX_FSR3UPSCALER_RESOURCE_IDENTIFIER_ACCUMULATION],
+        state->uavResources[FFX_FSR3UPSCALER_RESOURCE_IDENTIFIER_DILATED_REACTIVE_MASKS]};
+    auto& backend = state->contextDescription.backendInterface;
+    for (unsigned i=0; i<4; ++i) {
+        if (resources[i].internalIndex <= 0) continue;
+        const auto resource = backend.fpGetResource(&backend, resources[i]);
+        if (!resource.resource || resource.description.type != FFX_RESOURCE_TYPE_TEXTURE2D ||
+            (resource.description.flags & FFX_RESOURCE_FLAGS_UNDEFINED)) continue;
+        const auto format = toVkFormat(resource.description.format);
+        if (format == VK_FORMAT_UNDEFINED) continue;
+        result.images[i] = {reinterpret_cast<VkImage>(resource.resource), format,
+            getVKImageLayoutFromResourceState(resource.state),
+            resource.description.width, resource.description.height};
+        result.validImages |= 1u << i;
+    }
+    *info = result;
     return FFX_VK_PORTABLE_OK;
 }
 
