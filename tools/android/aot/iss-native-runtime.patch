+namespace {
+struct FpsimdRecord {
+    uint32_t magic, size;
+    uint32_t fpsr, fpcr;
+    __uint128_t v[32];
+};
+constexpr uint32_t FpsimdMagic = 0x46508001;
+FpsimdRecord* Fpsimd(ucontext_t* uc) {
+    auto* at = reinterpret_cast<unsigned char*>(uc->uc_mcontext.__reserved);
+    auto* end = at + sizeof(uc->uc_mcontext.__reserved);
+    while (at + 8 <= end) {
+        uint32_t magic, size;
+        std::memcpy(&magic, at, 4);
+        std::memcpy(&size, at + 4, 4);
+        if (!magic || size < 8 || size > static_cast<size_t>(end - at) || (size & 15)) break;
+        if (magic == FpsimdMagic) {
+            return size >= sizeof(FpsimdRecord) ? reinterpret_cast<FpsimdRecord*>(at) : nullptr;
+        }
+        at += size;
+    }
+    return nullptr;
+}
