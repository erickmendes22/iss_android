+BBR_EXPORT void* guest_cpu_context_current() { return Current(); }
+
+BBR_EXPORT void* guest_cpu_context_create(void* top, size_t) {
+    Thread* parent = Current();
+    self = nullptr;
+    Thread* fiber = Current();
+    *fiber->s = *parent->s;
+    for (unsigned i = 0; i < 2; ++i) {
+        if (parent->s->segment_arrays[i] == parent->s->private_gdt)
+            fiber->s->segment_arrays[i] = fiber->s->private_gdt;
+    }
+    fiber->s->callret_sp = 0;
+    fiber->stack_top = reinterpret_cast<uintptr_t>(top) & ~uintptr_t(15);
+    self = parent;
+    return fiber;
+}
+
+BBR_EXPORT void guest_cpu_context_use(void* context) {
+    if (self) self->suspended_host_rsp = GuestRspAtHostCall();
+    self = static_cast<Thread*>(context);
+    NoteGuestRsp(self ? self->suspended_host_rsp : 0);
+}
+
+BBR_EXPORT void guest_cpu_context_destroy(void* context) {
+    if (!context) return;
+    Thread* previous = self;
+    self = static_cast<Thread*>(context);
+    guest_cpu_thread_end();
+    self = previous == context ? nullptr : previous;
+    if (!self) NoteGuestRsp(0);
+}
+
+BBR_EXPORT void guest_cpu_get_fp_control(uint32_t* mxcsr, uint16_t* fcw) {
+    const GuestState& state = *Current()->s;
+    *mxcsr = state.mxcsr;
+    *fcw = state.FCW;
+}
+
+BBR_EXPORT void guest_cpu_set_fp_control(uint32_t mxcsr, uint16_t fcw) {
+    GuestState& state = *Current()->s;
+    state.mxcsr = mxcsr;
+    state.FCW = fcw;
+}
